<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- [KYA KARTA HAI]: Executable binary console application target format define karta hai. -->
    <!-- [KYU ZAROORI HAI]: GPU/SIMT Matrix Compute Engine ko independent runnable micro-accelerator ki tarah execute karne ke liye. -->
    <!-- [KAISE CHALTA HAI]: Roslyn compiler ise PE/ELF executable banata hai. -->
    <!-- [OUTPUT / SIDE EFFECT]: KiranaHub.GpuMatrixCompute.exe generate hota hai. -->
    <!-- [VARIATIONS TO TRY]: Native AOT compilation for maximum raw execution throughput. -->
    <OutputType>Exe</OutputType>

    <!-- [KYA KARTA HAI]: Target framework .NET 10.0 specify karta hai. -->
    <!-- [KYU ZAROORI HAI]: Modern Parallel.For, ThreadPool work-stealing, Memory<T>, aur Span<T> hardware cache optimizations ke liye. -->
    <!-- [KAISE CHALTA HAI]: Modern CoreCLR runtime target karta hai. -->
    <!-- [OUTPUT / SIDE EFFECT]: Net10.0 BCL APIs activate hoti hain. -->
    <!-- [VARIATIONS TO TRY]: net8.0 ya net9.0 par bhi execute kiya ja sakta hai. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- [KYA KARTA HAI]: Implicit global usings enable karta hai. -->
    <!-- [KYU ZAROORI HAI]: System, System.Threading.Tasks bar-bar import karne ka boilerplate khatam hota hai. -->
    <!-- [KAISE CHALTA HAI]: Compiler implicitly standard namespaces inject karta hai. -->
    <!-- [OUTPUT / SIDE EFFECT]: Cleaner C# source code. -->
    <!-- [VARIATIONS TO TRY]: Disable karke explicit namespaces add kar sakte hain. -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- [KYA KARTA HAI]: Nullable reference types strict mode enable karta hai. -->
    <!-- [KYU ZAROORI HAI]: Large multidimensional array indices aur embedding tensors me null reference crashes rokna. -->
    <!-- [KAISE CHALTA HAI]: Compile-time null-safety warnings produce karta hai. -->
    <!-- [OUTPUT / SIDE EFFECT]: Zero NullReferenceExceptions in compute kernel. -->
    <!-- [VARIATIONS TO TRY]: Allow unsafe blocks for raw unmanaged pointer arithmetic. -->
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
