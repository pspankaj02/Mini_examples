@model KiranaHub.MvcWeb.ViewModels.CartSummaryViewModel

<a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light position-relative">
    <i class="bi bi-cart3"></i> Cart
    <span id="header-cart-badge" class="badge bg-danger rounded-pill ms-1">
        @Model.TotalItemCount
    </span>
    <span id="header-cart-total" class="ms-1 fw-bold">
        Rs. @Model.GrandTotal.ToString("F2")
    </span>
</a>

