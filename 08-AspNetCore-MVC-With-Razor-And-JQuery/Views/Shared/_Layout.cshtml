@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KiranaHub Store</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Anti-Forgery Token for AJAX requests -->
    <meta name="csrf-token" content="@Xsrf.GetAndStoreTokens(Context).RequestToken" />
    <style>
        .kirana-brand { font-weight: 800; letter-spacing: -0.5px; }
        .product-card { transition: transform 0.2s, box-shadow 0.2s; }
        .product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
    </style>
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
        <div class="container">
            <a class="navbar-brand kirana-brand fs-4" asp-controller="Catalog" asp-action="Index">
                <i class="bi bi-basket-fill text-warning"></i> KiranaHub
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Catalog" asp-action="Index">
                            <i class="bi bi-grid"></i> Daily Groceries
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <!-- Live Cart ViewComponent -->
                    @await Component.InvokeAsync("LiveCartSummary")
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- Global Toast Container for jQuery AJAX Feedback -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveToast" class="toast align-items-center text-white bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                    Item updated.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 & jQuery Bundle -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global AJAX Setup Script: Automatically attaches CSRF Token to every jQuery AJAX POST -->
    <script>
        $(function () {
            var csrfToken = $('meta[name="csrf-token"]').attr('content');
            $.ajaxSetup({
                headers: {
                    'RequestVerificationToken': csrfToken
                }
            });
        });

        function showToast(message, isError) {
            var toastEl = $('#liveToast');
            if (isError) {
                toastEl.removeClass('bg-dark bg-success').addClass('bg-danger');
            } else {
                toastEl.removeClass('bg-dark bg-danger').addClass('bg-success');
            }
            $('#toastMessage').text(message);
            var toast = new bootstrap.Toast(toastEl[0]);
            toast.show();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
