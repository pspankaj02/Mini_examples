@model KiranaHub.MvcWeb.ViewModels.CatalogIndexViewModel
@{
    ViewData["Title"] = "Fresh Groceries Catalog";
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h2 class="fw-bold mb-1"><i class="bi bi-shop text-success"></i> Instant Grocery Catalog</h2>
        <p class="text-muted mb-0">Delivering fresh groceries to your doorstep in 10 minutes</p>
    </div>
    <div class="col-md-6 mt-3 mt-md-0">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="search" class="form-control rounded-pill" 
                   placeholder="Search items (e.g. Milk, Atta, Tea)..." value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(Model.SelectedCategory) || !string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Reset</a>
            }
        </form>
    </div>
</div>

<!-- Category Filter Pills -->
<div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
    <a asp-action="Index" class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(Model.SelectedCategory) ? "btn-success" : "btn-outline-secondary")">
        All Items
    </a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-action="Index" asp-route-category="@cat" 
           class="btn btn-sm rounded-pill @(Model.SelectedCategory == cat ? "btn-success" : "btn-outline-secondary")">
            @cat
        </a>
    }
</div>

<!-- Product Cards Grid -->
<div class="row">
    @if (Model.Products.Count == 0)
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-emoji-frown display-4 text-muted"></i>
            <h4 class="mt-3 text-secondary">No grocery products found</h4>
            <p class="text-muted">Try adjusting your search or category filter.</p>
        </div>
    }
    else
    {
        @foreach (var product in Model.Products)
        {
            <!-- Render Reusable Partial View -->
            <partial name="_ProductCard" model="product" />
        }
    }
</div>

@section Scripts {
    <!-- jQuery AJAX Add-To-Cart Script -->
    <script>
        $(document).ready(function () {
            // [JQUERY EVENT DELEGATION]: Button click listener
            $('.btn-add-to-cart').on('click', function () {
                var btn = $(this);
                var productId = btn.data('product-id');
                var productName = btn.data('product-name');

                // UI loading state
                var originalHtml = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                // [JQUERY AJAX POST WITH CSRF PROTECTION]
                $.ajax({
                    url: '/Cart/AddToCartAjax',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ productId: productId, quantity: 1 }),
                    success: function (response) {
                        if (response.success) {
                            // Update Live Cart Summary in Header without refreshing page!
                            $('#header-cart-badge').text(response.cartCount);
                            $('#header-cart-total').text('Rs. ' + Number(response.cartTotal).toFixed(2));
                            
                            // Pop toast notification
                            showToast(response.message, false);

                            btn.html('<i class="bi bi-check-lg text-success"></i> Added');
                            setTimeout(function () {
                                btn.prop('disabled', false).html(originalHtml);
                            }, 1200);
                        }
                    },
                    error: function (xhr) {
                        var err = xhr.responseJSON ? xhr.responseJSON.message : "Error adding to cart.";
                        showToast(err, true);
                        btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });
        });
    </script>
}

